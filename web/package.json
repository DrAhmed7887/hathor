{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test lib/validation.test.ts lib/document-intelligence.test.ts lib/phase-e-summary.test.ts lib/visit-grouping.test.ts lib/trust-gate.test.ts lib/slot-state.test.ts lib/image-crop.test.ts lib/countries.test.ts lib/antigen-normalizer.test.ts lib/schedule-diff.test.ts lib/passport/issue.test.ts",
    "debug:synthetic": "node --experimental-strip-types scripts/debug-synthetic-card.ts",
    "remotion:studio": "remotion studio",
    "render:fanout": "remotion render AgentFanOut ../video/assets/agent_fanout.mp4 --codec=h264 --crf=18",
    "render:cost": "remotion render CostAnimation ../video/assets/cost_animation.mp4 --codec=h264 --crf=18",
    "render:gates": "remotion render SafetyGates ../video/assets/safety_gates.mp4 --codec=h264 --crf=18",
    "render:hathor60s": "remotion render Hathor60s ../video/hathor-60s-storyboard/out/hathor-60s.mp4 --codec=h264 --crf=18",
    "render:all": "npm run render:fanout && npm run render:cost && npm run render:gates"
  },
